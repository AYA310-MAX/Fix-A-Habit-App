<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Fix_A_Habit_App.DashboardPage">
    <Grid RowDefinitions="Auto, Auto, *" Padding="20">
        <Label Text="Main Dashboard" FontSize="20" HorizontalOptions="Center" Grid.Row="0"/>

        <Frame Grid.Row="1" CornerRadius="20" HasShadow="True" Margin="0,20" Padding="20" HeightRequest="200">
            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center">
                <Label Text="CURRENT STREAK" FontSize="14" HorizontalOptions="Center"/>
                <Label Text="15 DAYS" FontSize="48" FontAttributes="Bold" HorizontalOptions="Center"/>
                <Label Text="clean &amp; focused" FontSize="12" HorizontalOptions="Center"/>

                <BoxView HeightRequest="60" WidthRequest="200" Color="LightGray" Margin="0,10"/>
            </VerticalStackLayout>
        </Frame>

        <VerticalStackLayout Grid.Row="2" Spacing="10">
            <Label Text="Daily Habits" FontAttributes="Bold" FontSize="18"/>
            <Frame HeightRequest="60" CornerRadius="10" BackgroundColor="#F0F0F0"/>
            <Frame HeightRequest="60" CornerRadius="10" BackgroundColor="#F0F0F0"/>
        </VerticalStackLayout>
    </Grid>
</ContentPage>