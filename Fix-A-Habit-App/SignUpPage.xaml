<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Fix_A_Habit_App.SignUpPage">
    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="15" VerticalOptions="Center">
            <Label Text="SIGN UP" FontSize="32" FontAttributes="Bold" HorizontalOptions="Center" Margin="0,0,0,20"/>
            <Entry Placeholder="Full Name" />
            <Entry Placeholder="Email" Keyboard="Email" />
            <Entry Placeholder="Password" IsPassword="True" />
            <Entry Placeholder="Password Confirmation" IsPassword="True" />
            <Button Text="Sign in" HeightRequest="50" CornerRadius="25" Margin="0,20,0,0"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
    