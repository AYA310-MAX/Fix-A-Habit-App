<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Fix_A_Habit_App.HabitDetailsPage"
             Title="Habit Details">

    <Grid RowDefinitions="Auto, Auto, *, Auto" Padding="20" Spacing="15">

        <HorizontalStackLayout Grid.Row="0" Spacing="10">
            <ImageButton Source="back_arrow.png" WidthRequest="30" HeightRequest="30"/>
            <Label Text="Details" VerticalOptions="Center" FontAttributes="Bold"/>
        </HorizontalStackLayout>

        <VerticalStackLayout Grid.Row="1" Spacing="5" Margin="0,10">
            <Label Text="Procrastination" FontSize="28" FontAttributes="Bold" />
            <Label Text="Target: Less than 30m daily" Opacity="0.7" />
        </VerticalStackLayout>

        <Frame Grid.Row="2" CornerRadius="20" HasShadow="False">
            <VerticalStackLayout Spacing="20" VerticalOptions="Center">
                <Label Text="WEEKLY PROGRESS" HorizontalOptions="Center" FontSize="12"/>

                <Grid HeightRequest="200" WidthRequest="200" HorizontalOptions="Center">
                    <Ellipse Stroke="LightGray" StrokeThickness="10"/>
                    <Label Text="75%" FontSize="36" FontAttributes="Bold" 
                           HorizontalOptions="Center" VerticalOptions="Center"/>
                </Grid>

                <Label Text="You've saved 4 hours this week!" 
                       HorizontalOptions="Center" 
                       HorizontalTextAlignment="Center"/>
            </VerticalStackLayout>
        </Frame>

        <Button Grid.Row="3" 
                Text="LOG PROGRESS" 
                HeightRequest="50" 
                CornerRadius="25" />

    </Grid>
</ContentPage>